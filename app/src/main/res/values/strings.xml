    <string name="set_033">While the new station loads, the old one keeps playing — no silence in between.</string>
    <string name="set_034">Buffer</string>
    <string name="set_035">A reserve of audio for when the connection drops. Not needed at home on stable internet — without it you\'re closer to live.</string>
    <string name="set_036">Off</string>
    <string name="set_037">On</string>
    <string name="set_038">Auto</string>
    <string name="set_039">up to 3 minutes of reserve for trips out of town. Turn off with the “Highway” button on the main screen or pick another mode here</string>
    <string name="set_040">always fills</string>
    <string name="set_041">fills on mobile data and phone hotspots, not on home Wi-Fi</string>
    <string name="set_042">only the few seconds a stream needs to play; after a pause — straight to live</string>
    <string name="set_043">Reserve size</string>
    <string name="set_044">10 s</string>
    <string name="set_045">30 s</string>
    <string name="set_046">60 s</string>
    <string name="set_047">Fill buffer while playing</string>
    <string name="set_048" formatted="false">plays 3% slower until the reserve fills; pitch stays the same</string>
    <string name="set_049">The buffer is how far behind live you are. The “Go live” button on the main screen resets it: a fresh stream with a crossfade.\nA pause shorter than the buffer resumes where you left off, so you miss nothing. Longer, or with the buffer off — straight to live.</string>
